kerendiamonds.xubi.org {
    # Applied to every response, including the API routes below - Caddy's
    # automatic HTTPS already redirects http->https, but nothing here was
    # telling the browser to *require* HTTPS on repeat visits, or blocking
    # this site (admin/order pages included) from being framed by another
    # site for clickjacking.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # frame-ancestors only (not a full CSP) - the frontend loads Google
        # Sign-In and Cloudinary-hosted images, and a resource-restricting
        # CSP written blind here risks silently breaking one of those
        # without a way to browser-test it from this pass. frame-ancestors
        # is the modern, non-breaking equivalent of X-Frame-Options above.
        Content-Security-Policy "frame-ancestors 'self'"
    }

    # /order, /favorite, and /admin are both React Router's own SPA pages
    # AND this service's REST paths at the exact same prefixes. A hard
    # refresh/direct link/bookmark of one of those pages is a real browser
    # navigation - Accept: text/html - and needs the SPA shell, not the API;
    # the frontend's own axios calls to these same paths ask for
    # application/json instead. Route the html-navigation case to the SPA so
    # its client-side router can take over (which then makes its own JSON
    # request to the same path and correctly reaches the API on that second,
    # separate request); everything else - every non-GET, and every
    # JSON-accepting GET - reaches the real API as before.
    @spa_navigation {
        method GET
        header Accept *text/html*
    }

    handle /api/items/* {
        reverse_proxy items-service:8080
    }
    handle /authenticate* {
        reverse_proxy users-service:8081
    }
    handle /users* {
        reverse_proxy users-service:8081
    }
    handle /order* {
        handle @spa_navigation {
            reverse_proxy frontend:80
        }
        handle {
            reverse_proxy users-service:8081
        }
    }
    handle /favorite* {
        handle @spa_navigation {
            reverse_proxy frontend:80
        }
        handle {
            reverse_proxy users-service:8081
        }
    }
    handle /admin* {
        handle @spa_navigation {
            reverse_proxy frontend:80
        }
        handle {
            reverse_proxy users-service:8081
        }
    }
    handle {
        reverse_proxy frontend:80
    }
}
