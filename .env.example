# Copy this file to .env and fill in real values before running
# `docker compose up`. .env itself is gitignored - never commit real secrets.

# Shared between items-service and users-service - both must have the exact
# same value, since users-service issues the JWTs and items-service verifies
# them independently.
JWT_SECRET=replace-with-a-random-base64-secret

# Postgres superuser used by both services to connect (one shared container,
# two separate databases - see postgres-init/init-databases.sh)
POSTGRES_USER=karen
POSTGRES_PASSWORD=replace-with-a-random-password

# Google OAuth Web client ID (not a secret - safe to expose client-side too).
# Needed TWICE with the same value: GOOGLE_CLIENT_ID for users-service to
# verify Google Sign-In ID tokens server-side, and REACT_APP_GOOGLE_CLIENT_ID
# for the frontend's Docker build (docker-compose build.args - CRA bakes it
# into the JS bundle at build time, it can't read a runtime env var). Needed
# for local dev too, not just production - `docker compose up --build`
# without this ships a frontend with no working Google button at all.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
REACT_APP_GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id

# --- Production-only (leave commented for local dev - safe localhost
# defaults are baked into the app/compose file already) ---
#
# Real address the frontend is served from - both backend services use this
# for CORS. Must match exactly what's in the browser's address bar (scheme +
# host + port), e.g. http://<EC2_PUBLIC_IP>:3000 or https://your-domain.com
# FRONTEND_URL=
#
# Real addresses the frontend's own JS calls from the browser - baked into
# the frontend image AT BUILD TIME (docker-compose build.args), so this must
# be set *before* `docker compose up --build` runs, not just before the
# containers start.
# REACT_APP_ITEMS_API_URL=http://<EC2_PUBLIC_IP>:8080/api/items
# REACT_APP_USERS_API_URL=http://<EC2_PUBLIC_IP>:8081
