# Copy this file to .env and fill in real values before running
# `docker compose up`. .env itself is gitignored - never commit real secrets.

# Shared between items-service and users-service - both must have the exact
# same value, since users-service issues the JWTs and items-service verifies
# them independently.
JWT_SECRET=replace-with-a-random-base64-secret

# Postgres superuser used by both services to connect (one shared container,
# two separate databases - see postgres-init/init-databases.sh)
POSTGRES_USER=karen
POSTGRES_PASSWORD=replace-with-a-random-password

# Google OAuth Web client ID (not a secret - safe to expose client-side too)
# used by users-service to verify Google Sign-In ID tokens on /authenticate/google.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
